---
import { t, detectLang } from '../../i18n/comments';
import type { Lang } from '../../i18n/comments';

const lang = detectLang(Astro.url.pathname) as Lang;
const i = t(lang);
const API_URL = import.meta.env.PUBLIC_COMMENTS_API_URL;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{i.adminTitle}</title>
  <meta name="robots" content="noindex, nofollow" />
</head>
<body>
  <main class="admin-panel" data-api={API_URL}>
    <h1>{i.adminTitle}</h1>

    <div class="auth-section">
      <label for="admin-token">{i.tokenLabel}</label>
      <div class="auth-row">
        <input
          type="password"
          id="admin-token"
          placeholder={i.tokenPlaceholder}
        />
        <button id="load-btn">{i.loadButton}</button>
      </div>
    </div>

    <div id="status-message" class="status" hidden></div>

    <div id="pending-list" class="pending-list"></div>
  </main>

  <script define:vars={{ labels: {
    loading: i.loading,
    noPending: i.noPending,
    approve: i.approve,
    reject: i.reject,
    page: i.page,
    author: i.author,
    email: i.email,
    date: i.date,
    content: i.content,
    actionSuccess: i.actionSuccess,
    actionError: i.actionError,
    loadButton: i.loadButton,
  }}}>
    // Labels are injected via define:vars
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const panel = document.querySelector('.admin-panel') as HTMLElement;
      const api = panel.dataset.api || '';
      const tokenInput = document.getElementById('admin-token') as HTMLInputElement;
      const loadBtn = document.getElementById('load-btn') as HTMLButtonElement;
      const statusEl = document.getElementById('status-message') as HTMLElement;
      const listEl = document.getElementById('pending-list') as HTMLElement;

      // Access labels from the define:vars script
      const l = (window as any).labels || {
        loading: 'Loading...', noPending: 'No pending comments.',
        approve: 'Approve', reject: 'Reject', page: 'Page', author: 'Author',
        email: 'Email', date: 'Date', content: 'Content',
        actionSuccess: 'Action completed.', actionError: 'Action failed.',
        loadButton: 'Load pending comments',
      };

      function showStatus(msg: string, isError = false) {
        statusEl.textContent = msg;
        statusEl.className = 'status ' + (isError ? 'error' : 'info');
        statusEl.hidden = false;
      }

      function hideStatus() {
        statusEl.hidden = true;
      }

      async function loadComments() {
        const token = tokenInput.value.trim();
        if (!token) return;

        loadBtn.disabled = true;
        loadBtn.textContent = l.loading;
        hideStatus();
        listEl.innerHTML = '';

        try {
          const res = await fetch(`${api}?action=admin&token=${encodeURIComponent(token)}`);
          const data = await res.json();

          if (data.ok === false) {
            showStatus(data.error || l.actionError, true);
            return;
          }

          if (!Array.isArray(data) || data.length === 0) {
            showStatus(l.noPending);
            return;
          }

          renderComments(data);
        } catch {
          showStatus(l.actionError, true);
        } finally {
          loadBtn.disabled = false;
          loadBtn.textContent = l.loadButton;
        }
      }

      function renderComments(comments: any[]) {
        listEl.innerHTML = '';
        comments.forEach((c) => {
          const card = document.createElement('div');
          card.className = 'comment-card';
          card.dataset.id = String(c.id);

          const dateStr = c.date ? new Date(c.date).toLocaleString() : '';

          card.innerHTML = `
            <div class="card-field"><strong>${l.page}:</strong> ${escapeHtml(c.page)}</div>
            <div class="card-field"><strong>${l.author}:</strong> ${escapeHtml(c.author)}</div>
            <div class="card-field"><strong>${l.email}:</strong> ${escapeHtml(c.email || '')}</div>
            <div class="card-field"><strong>${l.date}:</strong> ${escapeHtml(dateStr)}</div>
            <div class="card-content"><strong>${l.content}:</strong><br/>${escapeHtml(c.content)}</div>
            <div class="card-actions">
              <button class="btn-approve" data-id="${c.id}">${l.approve}</button>
              <button class="btn-reject" data-id="${c.id}">${l.reject}</button>
            </div>
          `;
          listEl.appendChild(card);
        });

        listEl.querySelectorAll('.btn-approve').forEach((btn) => {
          btn.addEventListener('click', () => moderate(btn.getAttribute('data-id')!, 'approved'));
        });
        listEl.querySelectorAll('.btn-reject').forEach((btn) => {
          btn.addEventListener('click', () => moderate(btn.getAttribute('data-id')!, 'rejected'));
        });
      }

      async function moderate(id: string, status: string) {
        const token = tokenInput.value.trim();
        hideStatus();

        const card = listEl.querySelector(`[data-id="${id}"]`) as HTMLElement | null;
        const buttons = card?.querySelectorAll('button');
        buttons?.forEach((b) => (b as HTMLButtonElement).disabled = true);

        try {
          const res = await fetch(api, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain' },
            body: JSON.stringify({ action: 'moderate', token, id, status }),
          });
          const data = await res.json();

          if (data.ok) {
            card?.remove();
            if (listEl.children.length === 0) {
              showStatus(l.noPending);
            }
          } else {
            showStatus(data.error || l.actionError, true);
            buttons?.forEach((b) => (b as HTMLButtonElement).disabled = false);
          }
        } catch {
          showStatus(l.actionError, true);
          buttons?.forEach((b) => (b as HTMLButtonElement).disabled = false);
        }
      }

      function escapeHtml(str: string): string {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
      }

      loadBtn.addEventListener('click', loadComments);

      tokenInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') loadComments();
      });
    });
  </script>

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: #f9fafb;
      color: #111827;
      min-height: 100vh;
    }

    .admin-panel {
      max-width: 800px;
      margin: 0 auto;
      padding: 2rem 1rem;
    }

    h1 {
      font-size: 1.75rem;
      margin-bottom: 1.5rem;
    }

    .auth-section {
      margin-bottom: 1.5rem;
    }

    .auth-section label {
      display: block;
      font-weight: 600;
      font-size: 0.9rem;
      margin-bottom: 0.4rem;
    }

    .auth-row {
      display: flex;
      gap: 0.5rem;
    }

    .auth-row input {
      flex: 1;
      padding: 0.5rem 0.75rem;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      font-size: 0.95rem;
    }

    .auth-row input:focus {
      outline: none;
      border-color: #6366f1;
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
    }

    .auth-row button,
    .btn-approve,
    .btn-reject {
      padding: 0.5rem 1rem;
      border: none;
      border-radius: 6px;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
    }

    .auth-row button {
      background: #4f46e5;
      color: white;
    }
    .auth-row button:hover { background: #4338ca; }
    .auth-row button:disabled { opacity: 0.6; cursor: not-allowed; }

    .status {
      padding: 0.75rem 1rem;
      border-radius: 6px;
      margin-bottom: 1rem;
      font-size: 0.9rem;
    }
    .status.info { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }
    .status.error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }

    .comment-card {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 1.25rem;
      margin-bottom: 1rem;
    }

    .card-field {
      margin-bottom: 0.35rem;
      font-size: 0.9rem;
    }

    .card-content {
      margin: 0.75rem 0;
      font-size: 0.9rem;
      white-space: pre-wrap;
      word-break: break-word;
      line-height: 1.5;
    }

    .card-actions {
      display: flex;
      gap: 0.5rem;
      margin-top: 0.75rem;
    }

    .btn-approve {
      background: #059669;
      color: white;
    }
    .btn-approve:hover { background: #047857; }

    .btn-reject {
      background: #dc2626;
      color: white;
    }
    .btn-reject:hover { background: #b91c1c; }

    .btn-approve:disabled,
    .btn-reject:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
  </style>
</body>
</html>
